# Puerto local del panel. Cámbialo si 3100 ya está ocupado.
APP_PORT=3100

# Acceso al panel. Usa una contraseña larga y única.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esta-clave-larga

# Base de datos exclusiva de esta integración. Usa valores diferentes y aleatorios.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_APP_PASSWORD=cambia-esta-clave-de-aplicacion

# Bsale: token de acceso de la API.
BSALE_BASE_URL=https://api.bsale.io
BSALE_ACCESS_TOKEN=

# Walmart Seller Center > API Key Management.
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_MARKET=mx
# Opcional: solo si Walmart te entregó un Consumer Channel Type en el onboarding.
WALMART_CHANNEL_TYPE=

# simulation | sandbox | production. Controla el entorno de la sincronización programada.
SYNC_MODE=simulation
# Mantén false hasta validar un SKU. Producción también exige confirmación en el panel.
ALLOW_WALMART_WRITES=false
DISABLE_SCHEDULER=false
